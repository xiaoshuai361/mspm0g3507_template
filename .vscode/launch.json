                               "searchDir":  [
                                                 "F:/APPS/openocd/xpack-openocd-0.12.0-7/openocd/scripts"
                                             ],
                               "configFiles":  [
                                                   "interface/jlink.cfg",
                                                   "target/ti_mspm0.cfg"
                                               ],
                               "serverArgs":  [
                                                  "-c",
