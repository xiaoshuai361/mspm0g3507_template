{
    "version":  "0.2.0",
    "configurations":  [
                           {
                               "name":  "Debug: J-Link OpenOCD",
                               "type":  "cortex-debug",
                               "request":  "launch",
                               "servertype":  "openocd",
                               "cwd":  "${workspaceFolder}",
                               "executable":  "${workspaceFolder}/Debug/cy_template.out",
                               "device":  "MSPM0G3507",
